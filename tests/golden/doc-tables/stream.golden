chunk %23%20Tables%20you%20can%20pull%20about%0A
chunk %0A
chunk Every%20table%20on%20this%20page%20has%20a%20handle%20on%20the%20right%20edge%20of%20each%20column.%20Put%20the%0A
chunk mouse%20on%20one,%20press,%20and%20drag:%20the%20column%20is%20set%20to%20the%20width%20you%20give%20it%20and%0A
chunk its%20cells%20are%20broken%20again%20as%20paragraphs%20of%20that%20width.%20A%20handle%20between%20two%0A
chunk columns%20moves%20the%20boundary%20and%20leaves%20the%20table%20as%20wide%20as%20it%20was;%20the%20handle%0A
chunk on%20the%20table's%20right%20edge%20makes%20the%20last%20column,%20and%20so%20the%20table,%20wider%20or%0A
chunk narrower.%20No%20column%20goes%20below%20its%20longest%20word.%0A
chunk %0A
chunk %23%23%20Short%20cells%0A
chunk %0A
chunk Nothing%20here%20needs%20to%20wrap%20at%20any%20width%20a%20pane%20is%20likely%20to%20have.%20Left%20alone,%0A
chunk a%20table%20that%20fits%20is%20scaled%20up%20to%20fill%20the%20measure.%0A
chunk %0A
chunk |%20Delimiter%20row%20|%20The%20column%20is%20set%20|%0A
chunk |%20---%20|%20---%20|%0A
chunk |%20`---`%20|%20flush%20left%20|%0A
chunk |%20`:---`%20|%20flush%20left%20|%0A
chunk |%20`:---:`%20|%20centred%20|%0A
chunk |%20`---:`%20|%20flush%20right%20|%0A
chunk %0A
chunk %23%23%20Prose%20in%20cells%0A
chunk %0A
chunk A%20cell%20is%20horizontal%20material%20like%20a%20paragraph's,%20and%20when%20its%20column%20is%0A
chunk narrower%20than%20the%20cell%20it%20is%20broken%20first-fit%20at%20natural%20spacing,%20ragged%20on%20the%0A
chunk side%20its%20alignment%20leaves%20free.%0A
chunk %0A
chunk |%20Term%20|%20What%20it%20means%20here%20|%20Why%20it%20matters%20to%20a%20host%20|%0A
chunk |%20---%20|%20---%20|%20---%20|%0A
chunk |%20Measure%20|%20The%20width%20a%20paragraph%20is%20broken%20to,%20which%20for%20a%20pane%20is%20the%20width%20of%20the%20pane%20and%20for%20a%20cell%20is%20the%20width%20of%20its%20column%20less%20the%20padding.%20|%20A%20pane%20that%20changes%20width%20re-breaks%20every%20block,%20so%20a%20host%20that%20can%20hold%20the%20measure%20steady%20should.%20|%0A
chunk |%20Unit%20|%20One%20independent%20run%20of%20blocks,%20shipped%20and%20indexed%20on%20its%20own%20and%20stacked%20by%20offset.%20|%20Changing%20one%20table%20costs%20that%20table%20and%20nothing%20else,%20which%20is%20what%20the%20counter%20above%20the%20pane%20reports.%20|%0A
chunk |%20Floor%20|%20The%20widest%20stretch%20of%20a%20cell%20that%20no%20line%20break%20can%20divide:%20its%20longest%20word.%20|%20Below%20it%20the%20word%20would%20run%20into%20the%20next%20column,%20so%20nothing%20sets%20a%20column%20narrower.%20|%0A
chunk %0A
chunk %23%23%20Alignment%20by%20column%0A
chunk %0A
chunk The%20second%20column%20is%20centred%20and%20the%20third%20and%20fourth%20are%20set%20flush%20right,%20as%0A
chunk the%20markdown%20asks%20with%20colons%20in%20its%20delimiter%20row.%20Wrapped%20lines%20keep%20their%0A
chunk column's%20alignment.%0A
chunk %0A
chunk |%20Unit%20|%20Name%20|%20In%20points%20|%20Scaled%20points%20|%0A
chunk |%20:---%20|%20:---:%20|%20---:%20|%20---:%20|%0A
chunk |%20pt%20|%20point%20|%201%20|%2065536%20|%0A
chunk |%20pc%20|%20pica%20|%2012%20|%20786432%20|%0A
chunk |%20in%20|%20inch%20|%2072.27%20|%204736286%20|%0A
chunk |%20bp%20|%20big%20point,%20the%20PostScript%20point%20|%201.00375%20|%2065781%20|%0A
chunk |%20cm%20|%20centimetre%20|%2028.45275%20|%201864679%20|%0A
chunk %0A
chunk %23%23%20A%20table%20too%20wide%20for%20the%20pane%0A
chunk %0A
chunk Its%20cells%20set%20on%20one%20line%20are%20wider%20than%20the%20measure,%20so%20the%20columns%20are%0A
chunk squeezed:%20each%20keeps%20at%20least%20its%20longest%20word%20and%20what%20is%20left%20is%20shared%20by%0A
chunk how%20much%20each%20could%20use.%20Drag%20a%20column%20down%20to%20its%20floor%20and%20watch%20the%20row%0A
chunk grow.%0A
chunk %0A
chunk |%20Stage%20|%20What%20it%20takes%20in%20|%20What%20it%20hands%20on%20|%20Where%20it%20can%20go%20wrong%20|%20What%20it%20costs%20|%0A
chunk |%20---%20|%20---%20|%20---%20|%20---%20|%20---%20|%0A
chunk |%20Convert%20|%20Markdown%20source,%20a%20theme%20and%20a%20metrics%20resolver%20|%20Blocks%20of%20horizontal%20material,%20one%20for%20each%20paragraph,%20code%20block,%20rule%20and%20table%20|%20Markdown%20the%20converter%20does%20not%20know%20is%20not%20set%20as%20anything%20|%20Paid%20once%20for%20each%20edit%20of%20the%20source%20|%0A
chunk |%20Compose%20|%20Blocks,%20a%20measure%20and%20the%20line%20breaking%20parameters%20|%20A%20vertical%20list%20of%20boxes%20with%20the%20glue%20between%20them%20|%20A%20word%20wider%20than%20its%20line%20leaves%20that%20line%20overfull%20|%20The%20line%20breaker,%20which%20is%20most%20of%20what%20a%20relayout%20spends%20|%0A
chunk |%20Ship%20|%20A%20box%20and%20the%20point%20its%20reference%20sits%20at%20|%20Glyph,%20rule%20and%20line%20commands%20at%20absolute%20positions%20|%20Nothing%20a%20reader%20would%20see:%20it%20is%20arithmetic%20over%20the%20box%20|%20One%20pass%20over%20the%20box%20|%0A
chunk |%20Draw%20|%20The%20commands%20the%20window%20can%20see%20|%20Vertices%20in%20the%20draw%20list%20of%20whatever%20window%20is%20current%20|%20A%20face%20that%20is%20not%20in%20the%20atlas%20is%20drawn%20in%20the%20bound%20font%20|%20The%20glyphs%20on%20screen%20and%20not%20the%20document%20|%0A
chunk %0A
chunk %23%23%20Links%20in%20cells%0A
chunk %0A
chunk A%20link%20in%20a%20cell%20is%20live%20like%20any%20other:%20the%20pointer%20changes%20over%20it%20and%20a%0A
chunk click%20is%20reported%20in%20the%20line%20above%20the%20pane.%20A%20press%20on%20a%20link%20is%20the%20link's%0A
chunk and%20a%20press%20on%20a%20handle%20is%20the%20handle's;%20neither%20begins%20a%20selection.%0A
chunk %0A
