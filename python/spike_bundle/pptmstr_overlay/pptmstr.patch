+            add(ts.Block(text="(fence not closed)", style=_STYLE["warn"]))
+    else:
+        # LITERAL, and live prose too long to parse every frame: verbatim lines.
+        add(
+            ts.Block(
+                ts.BlockKind.Code,
+                "\n".join(block.lines),
+                style=_STYLE[f"literal-{block.segment_kind.value}"],
+            )
